; mirror's preconditions
mirror C                                      ; the seam is every face
mirror[n9] C                                  ; the seam is no face
mirror[+x|-x] C                               ; an edge joins two seam corners outside the seam
mirror[#5|#7] k[+z](0.5) C                    ; the seam meets itself at the apex
mirror[#5|#6] k[+z](0.5) C                    ; neighbouring triangles are fine
